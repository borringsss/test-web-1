# Database connection string
# Standard PostgreSQL (Local, Supabase, Neon, Railway, Docker, etc.)
# If DATABASE_URL is not set or empty, the app automatically runs on embedded PGlite (PostgreSQL) engine!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lunion_pizza

# Better Auth Configuration
BETTER_AUTH_SECRET=lunion-pizza-secure-session-secret-key-32-chars-long
BETTER_AUTH_URL=http://localhost:3000
